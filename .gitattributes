* text=auto

# Keil/Windows 工程文件在工作区使用 CRLF
*.c text eol=crlf
*.h text eol=crlf
*.s text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.uvprojx text eol=crlf
*.uvoptx text eol=crlf
*.hex text eol=crlf
*.csv text eol=crlf

# 文档与 Python 脚本保持跨平台 LF
*.md text eol=lf
*.py text eol=lf
*.pyw text eol=lf

# 二进制文件不做行尾转换
*.bin binary
*.png binary
